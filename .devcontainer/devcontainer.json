{
  "name": "notify-msteams-action",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "updateRemoteUserUID": false,
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {
      "moby": false,
      "version": "latest",
      "dockerDashComposeVersion": "latest"
    }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/node/.asdf:/home/node/.asdf/shims:/home/node/.local/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions",
        "github.copilot-chat"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "eslint.validate": ["javascript", "typescript"]
      }
    }
  },
  "mounts": [
    "source=${env:HOME}${env:USERPROFILE}/.aws,target=/home/node/.aws,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gnupg,target=/home/node/.gnupg,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.bash_aliases,target=/home/node/.bash_aliases,type=bind,readonly"
  ],
  "initializeCommand": {
    "alias": "bash -c 'touch ~/.bash_aliases'",
    "env": "bash -c 'printf \"HOST_UID=$(id -u)\\nHOST_GID=$(id -g)\\n\" > .devcontainer/host.env'"
  },
  "postCreateCommand": "bash -c '.devcontainer/create.sh'",
  "remoteUser": "node"
}
