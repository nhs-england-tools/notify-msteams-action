FROM mcr.microsoft.com/devcontainers/typescript-node:5-24-trixie

RUN apt-get update \
    && apt-get -y install --no-install-recommends \
    git wget curl \
    && apt-get clean -y && rm -rf /var/lib/apt/lists/*

# Download ASDF
RUN wget https://github.com/asdf-vm/asdf/releases/download/v0.16.7/asdf-v0.16.7-linux-amd64.tar.gz -O - | tar xz \
    && sudo mv asdf /usr/bin/asdf


# Generated by initializeCommand — contains HOST_UID and HOST_GID from the host
COPY host.env /tmp/host.env

# Ensure the existing node user's UID/GID matches the host
# prevents permission issues or for image to be built twice (as updateRemoteUserUID false).
RUN . /tmp/host.env \
    && groupmod -g $HOST_GID node \
    && usermod -u $HOST_UID -g $HOST_GID node \
    && chown -R node:node /home/node

USER node
# Setup ASDF
RUN echo "export ASDF_DATA_DIR=/home/node/.asdf" >> ~/.bashrc \
    && echo ". <(asdf completion bash)" >> ~/.bashrc
