{
    "name": "notify-msteams-action",
    "version": "1.0.6",
    "private": true,
    "description": "GitHub Action to notify an MS Teams channel",
    "main": "lib/main.js",
    "scripts": {
        "build": "tsc",
        "format": "prettier --write **/*.ts",
        "format-check": "prettier --check **/*.ts",
        "lint": "eslint src/**/*.ts",
        "package": "npm run build && ncc build lib/main.js --source-map --license licenses.txt",
        "test": "jest",
        "all": "npm run format && npm run lint && npm run package && npm test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nhs-england-tools/notify-msteams-action.git"
    },
    "keywords": [
        "actions",
        "node",
        "setup"
    ],
    "author": "walteck",
    "license": "MIT",
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@actions/github": "^9.1.1",
        "axios": "^1.16.0",
        "html-entities": "^2.6.0"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vercel/ncc": "^0.45.0",
        "eslint": "^10.8.0",
        "eslint-plugin-github": "^6.1.2",
        "eslint-plugin-jest": "^29.16.0",
        "eslint-plugin-prettier": "^5.5.6",
        "jest": "^30.4.2",
        "js-yaml": "^5.2.2",
        "prettier": "^3.9.6",
        "ts-jest": "^29.4.12",
        "typescript": "^6.0.3"
    }
}
